      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: 'Cuatro fragmentos cayeron: bosque, aldea, cuevas y ruinas.'
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "Toma el fragmento que brilla entre los \xE1rboles y sigue el camino
        al este."
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Si me compras una venda con tus monedas, podr\xE9 seguir caminando
        contigo."
      objectReference: {fileID: 0}
