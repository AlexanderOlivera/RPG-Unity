      propertyPath: tradeItemName
      value: "Bendici\xF3n del sello"
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: lines.Array.size
      value: 4
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: tradeDescription
      value: "+15 de vida m\xE1xima y cura 15"
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[0]'
      value: "Este era el santuario donde se forj\xF3 el sello, hace cien inviernos."
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[1]'
      value: "Con los cuatro fragmentos la puerta del este se abrir\xE1."
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[2]'
      value: "Dentro espera el Guardi\xE1n. No es malvado: est\xE1 corrompido. Lib\xE9ralo."
      objectReference: {fileID: 0}
    - target: {fileID: 6013927225310612090, guid: e183dc3e895def94b8cdbb50bbee5480,
        type: 3}
      propertyPath: 'lines.Array.data[3]'
      value: "Y escucha: cuando lo enfrentes, invocar\xE1 esporas. Esquiva con Shift."
      objectReference: {fileID: 0}
